# Copy to `.env` and fill in. `.env` is gitignored; this file is the
# documentation of which variables the experiments expect.
#
# direnv (`.envrc` -> `dotenv_if_exists`) auto-loads `.env` whenever you
# `cd` into the repo, so notebooks running under `just lab` inherit it.

# --- NVIDIA NIM ----------------------------------------------------------
# Used by: experiments/llms/01-nim-model-survey.py via
#          experiments/shared/llm_clients.py::get_nim_client
# Get a key at https://build.nvidia.com/.
NVIDIA_API_KEY=

# Optional override. Defaults to https://integrate.api.nvidia.com/v1.
# Point at a self-hosted NIM container if you have one, e.g.
#   NIM_BASE_URL=http://my-nim:8000/v1
# NIM_BASE_URL=

# --- OpenAI embeddings ---------------------------------------------------
# Used only by experiments that set EMBEDDING_PROVIDER="openai".
OPENAI_API_KEY=
